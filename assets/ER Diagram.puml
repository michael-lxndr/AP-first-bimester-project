@startuml ER Diagram
title Gestion de Pedidos de Restaurante - Diagrama ER

hide methods
hide stereotypes
skinparam linetype ortho

entity "Rol" as Role {
  *role_id : BIGINT <<PK>>
  --
  role_name : VARCHAR(30) <<UK>>
}

entity "Personal" as Staff {
  *staff_id : BIGINT <<PK>>
  --
  role_id : BIGINT <<FK>>
  full_name : VARCHAR(120)
  phone : VARCHAR(20)
  email : VARCHAR(120) <<UK>>
  username : VARCHAR(50) <<UK>>
  is_active : BOOLEAN
  created_at : DATETIME
}

entity "Cliente" as Customer {
  *customer_id : BIGINT <<PK>>
  --
  full_name : VARCHAR(120)
  phone : VARCHAR(20)
  email : VARCHAR(120) <<UK>>
  is_active : BOOLEAN
  created_at : DATETIME
}

entity "DireccionCliente" as CustomerAddress {
  *address_id : BIGINT <<PK>>
  --
  customer_id : BIGINT <<FK>>
  alias : VARCHAR(50)
  main_street : VARCHAR(150)
  secondary_street : VARCHAR(150)
  house_number : VARCHAR(10)
  reference : VARCHAR(255)
  postal_code : VARCHAR(10)
  city : VARCHAR(50)
  province : VARCHAR(50)
  country : VARCHAR(50)
  is_primary : BOOLEAN
  is_active : BOOLEAN
}

entity "Producto" as Product {
  *product_id : BIGINT <<PK>>
  --
  product_code : VARCHAR(20) <<UK>>
  product_name : VARCHAR(120)
  description : VARCHAR(255)
  unit_price : DECIMAL(10,2)
  production_cost : DECIMAL(10,2)
  category : VARCHAR(30)
  preparation_time_minutes : INT
  is_available : BOOLEAN
  image_url : VARCHAR(255)
  created_at : DATETIME
}

entity "EstadoPedido" as OrderStatus {
  *status_id : BIGINT <<PK>>
  --
  status_code : VARCHAR(30) <<UK>>
  status_name : VARCHAR(50) <<UK>>
  status_order : INT <<UK>>
  is_final : BOOLEAN
}

entity "ReglaTransicionEstado" as OrderStatusTransitionRule {
  *transition_rule_id : BIGINT <<PK>>
  --
  from_status_id : BIGINT <<FK>>
  to_status_id : BIGINT <<FK>>
  role_id : BIGINT <<FK>>
  is_active : BOOLEAN
}

entity "PedidoCliente" as CustomerOrder {
  *order_id : BIGINT <<PK>>
  --
  order_code : VARCHAR(30) <<UK>>
  customer_id : BIGINT <<FK>>
  registered_by_staff_id : BIGINT <<FK>>
  current_status_id : BIGINT <<FK>>
  delivery_address_id : BIGINT <<FK>>
  delivery_address_snapshot : VARCHAR(500)
  delivery_instructions : VARCHAR(500)
  subtotal_amount : DECIMAL(10,2)
  tax_amount : DECIMAL(10,2)
  discount_amount : DECIMAL(10,2)
  address_surcharge_amount : DECIMAL(10,2)
  total_amount : DECIMAL(10,2)
  discount_code : VARCHAR(20)
  is_priority : BOOLEAN
  general_notes : VARCHAR(255)
  created_at : DATETIME
  estimated_delivery_at : DATETIME
  current_status_changed_at : DATETIME
}

entity "ItemPedido" as OrderItem {
  *order_item_id : BIGINT <<PK>>
  --
  order_id : BIGINT <<FK>>
  product_id : BIGINT <<FK>>
  quantity : INT
  product_name_snapshot : VARCHAR(120)
  unit_price : DECIMAL(10,2)
  line_total : DECIMAL(10,2)
  special_note : VARCHAR(150)
  is_ready : BOOLEAN
}

entity "HistorialEstadoPedido" as OrderStatusHistory {
  *history_id : BIGINT <<PK>>
  --
  order_id : BIGINT <<FK>>
  from_status_id : BIGINT <<FK>> <<DEFAULT:PENDING>>
  to_status_id : BIGINT <<FK>>
  changed_by_staff_id : BIGINT <<FK>>
  changed_at : DATETIME
  notes : VARCHAR(255)
}

entity "Entrega" as Delivery {
  *delivery_id : BIGINT <<PK>>
  --
  order_id : BIGINT <<FK>> <<UK>>
  courier_staff_id : BIGINT <<FK>>
  dispatched_at : DATETIME
  delivered_at : DATETIME <<NULL>>
  receiver_name : VARCHAR(120) <<NULL>>
  customer_confirmed_at : DATETIME <<NULL>>
  customer_confirmation_notes : VARCHAR(255) <<NULL>>
  delivery_status : VARCHAR(30)
  courier_notes : VARCHAR(500)
  attempt_number : INT
}

Role ||--o{ Staff : tiene
Role ||--o{ OrderStatusTransitionRule : autoriza

Customer ||--o{ CustomerOrder : realiza
Customer ||--o{ CustomerAddress : posee
CustomerAddress ||--o{ CustomerOrder : seleccionada_para

Staff ||--o{ CustomerOrder : registra
Staff ||--o{ OrderStatusHistory : cambia
Staff ||--o{ Delivery : reparte

OrderStatus ||--o{ CustomerOrder : estado_actual
OrderStatus ||--o{ OrderStatusTransitionRule : estado_origen
OrderStatus ||--o{ OrderStatusTransitionRule : estado_destino
OrderStatus ||--o{ OrderStatusHistory : desde_estado
OrderStatus ||--o{ OrderStatusHistory : hacia_estado

CustomerOrder ||--|{ OrderItem : contiene
CustomerOrder ||--o{ OrderStatusHistory : registra_historial
CustomerOrder ||--o| Delivery : tiene

Product ||--o{ OrderItem : aparece_en

note right of CustomerOrder
- order_code debe ser unico
- una orden debe contener al menos un item
- delivery_address_id referencia la direccion elegida
  por el cliente y es obligatoria porque define
  donde se realiza la entrega
- delivery_address_snapshot preserva la direccion
  historica aunque luego el cliente edite sus direcciones
  y admite hasta 500 caracteres
- delivery_instructions guarda indicaciones especiales
  para el repartidor
- total_amount = subtotal_amount + tax_amount
  + address_surcharge_amount - discount_amount
- los montos no pueden ser negativos segun checks
  de base de datos
- current_status_changed_at acelera consultas de seguimiento
- al crear la orden debe insertarse tambien
  el primer registro en HistorialEstadoPedido
end note

note right of CustomerAddress
- Un cliente puede registrar varias direcciones.
- is_primary marca la direccion sugerida por defecto.
- is_active permite ocultar direcciones sin borrar historial.
- Al crear un pedido se debe validar que la direccion
  pertenezca al cliente del pedido.
- city y province son obligatorias pero no tienen
  valor por defecto: deben venir del registro real
  de direccion del cliente.
- country es obligatorio y usa Ecuador por defecto.
end note

note right of Product
- product_code facilita busqueda e integracion externa.
- category clasifica menu: STARTER, MAIN_COURSE,
  DRINK, DESSERT, COMBO.
- preparation_time_minutes ayuda a estimar entrega.
- image_url permite mostrar la imagen del producto.
- unit_price, production_cost y preparation_time_minutes
  tienen validaciones CHECK para evitar valores invalidos.
- production_cost sirve para analisis interno,
  no debe exponerse necesariamente al cliente.
end note

note right of OrderStatus
Catalogo sugerido:
- PENDING / Pendiente
- IN_PREPARATION / En preparacion
- READY / Listo
- ON_THE_WAY / En camino
- DELIVERED / Entregado

Los codigos se mantienen en ingles por compatibilidad
con los enums Java persistidos con EnumType.STRING.

DELIVERED representa que el repartidor
confirmo la entrega.

La confirmacion del cliente no se modela
como nuevo estado; se guarda en Entrega
mediante customer_confirmed_at.

status_order tambien es unico y debe ser mayor a cero.
end note

note right of OrderStatusTransitionRule
Reglas de negocio trazables:
- PENDING -> IN_PREPARATION : COOK
- IN_PREPARATION -> READY : COOK
- READY -> ON_THE_WAY : COURIER
- ON_THE_WAY -> DELIVERED : COURIER

No se permiten saltos ni retrocesos.

Estas reglas aplican a Personal.
El Cliente no usa esta tabla porque
no cambia el estado operativo del pedido.

La base impide duplicar una regla mediante
UNIQUE(from_status_id, to_status_id, role_id).
end note

note right of OrderStatusHistory
- todo cambio de estado debe registrarse
- from_status_id es obligatorio; si no se informa,
  la base usa PENDING como estado inicial por defecto
- changed_by_staff_id + changed_at cubren
  quien hizo el cambio y cuando
- notes permite guardar observaciones
  operativas o incidencias
end note

note right of OrderItem
- product_name_snapshot preserva trazabilidad
  historica aunque cambie el nombre del producto
- unit_price conserva el precio usado
  al momento de crear el pedido
- special_note permite observaciones por producto
- is_ready permite seguimiento interno de cocina
end note

note right of Delivery
- dispatched_at se registra cuando el repartidor
  sale con el pedido
- delivery_status permite distinguir DISPATCHED,
  IN_TRANSIT, DELIVERED, FAILED y RETURNED
- courier_notes guarda novedades del repartidor
- attempt_number registra cuantos intentos de entrega hubo
- delivered_at y receiver_name se registran
  cuando el repartidor confirma la entrega
- customer_confirmed_at se registra cuando
  el cliente confirma que recibio el pedido
- delivered_at, receiver_name y customer_confirmed_at
  son campos opcionales hasta que avance la entrega
- si delivered_at tiene valor, receiver_name se vuelve
  obligatorio por CHECK de base de datos
- customer_confirmed_at solo puede existir despues
  de delivered_at
- el cliente solo puede confirmar si:
  1. el pedido esta DELIVERED
  2. existe Entrega
  3. delivered_at no es null
  4. el pedido pertenece a ese cliente
  5. todavia no fue confirmado
end note

@enduml
