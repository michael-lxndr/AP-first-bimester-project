<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.2" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence           http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd">
	<persistence-unit name="RestaurantPU" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
		<class>com.restaurante.pedidos.clases.ItemsPedido</class>
		<class>com.restaurante.pedidos.clases.HistorialEstadosPedido</class>
		<class>com.restaurante.pedidos.clases.Clientes</class>
		<class>com.restaurante.pedidos.clases.Roles</class>
		<class>com.restaurante.pedidos.clases.EstadosPedido</class>
		<class>com.restaurante.pedidos.clases.ReglasTransicionEstadoPedido</class>
		<class>com.restaurante.pedidos.clases.DireccionesCliente</class>
		<class>com.restaurante.pedidos.clases.PedidosCliente</class>
		<class>com.restaurante.pedidos.clases.Entregas</class>
		<class>com.restaurante.pedidos.clases.Productos</class>
		<class>com.restaurante.pedidos.clases.Personal</class>
		<properties>
			<property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/proyecto_primer_bimestre?serverTimezone=UTC"/>
			<property name="javax.persistence.jdbc.user" value="root"/>
			<property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			<property name="javax.persistence.jdbc.password" value="root"/>
			<property name="javax.persistence.schema-generation.database.action" value="create"/>
		</properties>
	</persistence-unit>
</persistence>
