<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurante.pedidos.presentacion.ControladorPanelPrincipal"
      alignment="CENTER"
      spacing="18"
      styleClass="screen">

	<padding>
		<Insets top="32" right="32" bottom="32" left="32"/>
	</padding>

	<Label text="Gestor de Pedidos del Restaurante" styleClass="title"/>
	<Label text="Proyecto JavaFX + JPA" styleClass="subtitle"/>

	<HBox alignment="CENTER" spacing="12">
		<Button text="Administrador" onAction="#abrirVistaAdministrador"/>
		<Button text="Cocinero" onAction="#abrirVistaCocinero"/>
		<Button text="Repartidor" onAction="#abrirVistaRepartidor"/>
		<Button text="Cliente" onAction="#abrirVistaCliente"/>
	</HBox>

	<Label fx:id="statusLabel" text="Selecciona una vista para continuar" styleClass="status"/>
	<Button text="Salir" onAction="#salirAplicacion" styleClass="exit-button"/>
</VBox>
