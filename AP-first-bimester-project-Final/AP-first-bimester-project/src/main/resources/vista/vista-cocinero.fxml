<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurante.pedidos.presentacion.controladores.ControladorCocinero"
      styleClass="mobile-screen, screen-cocinero"
      spacing="12">

    <padding>
        <Insets top="40" right="15" bottom="20" left="15"/>
    </padding>

    <!-- Header -->
    <VBox spacing="4" alignment="CENTER">
        <Label text="👨‍🍳 Cocinero" styleClass="title"/>
        <Label text="Cola de Preparación" styleClass="subtitle"/>
    </VBox>

    <!-- Estado conexión y refrescar -->
    <HBox spacing="10" alignment="CENTER">
        <Label fx:id="lblEstadoConexion" text="✅ Conectado" style="-fx-text-fill: #4caf50; -fx-font-size: 12px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefrescar" text="🔄" onAction="#cargarColaPreparacion"
                style="-fx-background-radius: 25; -fx-padding: 8 12;"/>
    </HBox>

    <!-- Lista de pedidos -->
    <Label text="📋 Pedidos en preparación" styleClass="section-title"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="contenedorCola" spacing="12">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>
        </VBox>
    </ScrollPane>

    <!-- Botón cerrar -->
    <Button text="Cerrar" onAction="#cerrarVentana" maxWidth="Infinity" styleClass="button-exit"/>
</VBox>