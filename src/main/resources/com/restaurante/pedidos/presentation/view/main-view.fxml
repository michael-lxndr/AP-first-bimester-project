<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
	  fx:controller="com.restaurante.pedidos.presentation.DashboardController"
      alignment="CENTER"
      spacing="18"
      styleClass="screen">

	<padding>
		<Insets top="32" right="32" bottom="32" left="32"/>
	</padding>

	<Label text="Restaurant Order Manager" styleClass="title"/>
	<Label text="Proyecto JavaFX + JPA" styleClass="subtitle"/>

	<HBox alignment="CENTER" spacing="12">
		<Button text="Administrador" onAction="#openAdminView"/>
		<Button text="Cocinero" onAction="#openCookView"/>
		<Button text="Repartidor" onAction="#openDeliveryView"/>
		<Button text="Cliente" onAction="#openCustomerView"/>
	</HBox>

	<Label fx:id="statusLabel" text="Selecciona una vista para continuar" styleClass="status"/>
	<Button text="Salir" onAction="#exitApplication" styleClass="exit-button"/>
</VBox>
