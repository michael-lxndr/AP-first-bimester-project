<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.restaurante.pedidos.presentacion.ControladorAdministrador"
            styleClass="screen">
	<padding>
		<Insets top="24" right="24" bottom="24" left="24"/>
	</padding>

	<top>
		<VBox spacing="6">
			<Label text="Administrador" styleClass="title"/>
			<Label text="CRUD de administradores, cocineros y repartidores" styleClass="subtitle"/>
		</VBox>
	</top>

	<center>
		<TableView fx:id="tablaPersonal" prefHeight="420">
			<columns>
				<TableColumn fx:id="columnaId" text="ID" prefWidth="60"/>
				<TableColumn fx:id="columnaRol" text="Rol" prefWidth="130"/>
				<TableColumn fx:id="columnaNombreCompleto" text="Nombre" prefWidth="220"/>
				<TableColumn fx:id="columnaNombreUsuario" text="Usuario" prefWidth="140"/>
				<TableColumn fx:id="columnaCorreo" text="Correo" prefWidth="220"/>
				<TableColumn fx:id="columnaEstado" text="Estado" prefWidth="100"/>
			</columns>
		</TableView>
	</center>

	<right>
		<VBox spacing="12" prefWidth="320" styleClass="form-card">
			<Label text="Datos del personal" styleClass="section-title"/>

			<GridPane hgap="8" vgap="10">
				<Label text="Rol" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
				<ComboBox fx:id="comboRol" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

				<Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
				<TextField fx:id="campoNombreCompleto" promptText="Nombre completo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

				<Label text="Teléfono" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
				<TextField fx:id="campoTelefono" promptText="0999999999" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

				<Label text="Correo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
				<TextField fx:id="campoCorreo" promptText="correo@example.com" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

				<Label text="Usuario" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
				<TextField fx:id="campoNombreUsuario" promptText="usuario" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
			</GridPane>

			<CheckBox fx:id="checkboxActivo" text="Activo"/>
			<Label fx:id="etiquetaMensaje" text="Seleccioná o creá personal" wrapText="true" styleClass="status"/>

			<HBox spacing="8">
				<Button text="Crear" onAction="#crearPersonal"/>
				<Button text="Modificar" onAction="#modificarPersonal"/>
			</HBox>
			<HBox spacing="8">
				<Button text="Alta/Baja" onAction="#alternarActivo"/>
				<Button text="Eliminar" onAction="#eliminarPersonal" styleClass="danger-button"/>
			</HBox>
			<HBox spacing="8">
				<Button text="Limpiar" onAction="#limpiarFormulario"/>
				<Button text="Cerrar" onAction="#cerrarVentana" styleClass="exit-button"/>
			</HBox>
		</VBox>
	</right>
</BorderPane>
