<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.restaurante.pedidos.presentacion.controladores.ControladorRepartidor"
      styleClass="mobile-screen, screen-repartidor"
      spacing="12">

    <padding>
        <Insets top="40" right="15" bottom="20" left="15"/>
    </padding>

    <!-- Header -->
    <VBox spacing="4" alignment="CENTER">
        <Label text="🛵 Repartidor" styleClass="title"/>
        <Label text="Entregas" styleClass="subtitle"/>
    </VBox>

    <!-- Estado conexión y refrescar -->
    <HBox spacing="10" alignment="CENTER">
        <Label fx:id="lblEstadoConexion" text="✅ Conectado" style="-fx-text-fill: #4caf50; -fx-font-size: 12px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnRefrescar" text="🔄" onAction="#cargarColas"
                style="-fx-background-radius: 25; -fx-padding: 8 12;"/>
    </HBox>

    <!-- Listos para retirar -->
    <Label text="📦 Listos para retirar" styleClass="section-title"/>
    <ScrollPane fitToWidth="true" prefHeight="280">
        <VBox fx:id="contenedorListos" spacing="12">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        </VBox>
    </ScrollPane>

    <!-- En camino -->
    <Label text="🚚 En camino" styleClass="section-title"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="contenedorEnCamino" spacing="12">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        </VBox>
    </ScrollPane>

    <!-- Botón cerrar -->
    <Button text="Cerrar" onAction="#cerrarVentana" maxWidth="Infinity" styleClass="button-exit"/>
</VBox>