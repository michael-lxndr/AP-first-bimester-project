<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

	<persistence-unit name="firstBimesterPU" transaction-type="RESOURCE_LOCAL">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

		<class>com.restaurante.pedidos.dominio.entidad.Cliente</class>
		<class>com.restaurante.pedidos.dominio.entidad.DireccionCliente</class>
		<class>com.restaurante.pedidos.dominio.entidad.PedidoCliente</class>
		<class>com.restaurante.pedidos.dominio.entidad.Entrega</class>
		<class>com.restaurante.pedidos.dominio.entidad.ItemPedido</class>
		<class>com.restaurante.pedidos.dominio.entidad.EstadoPedido</class>
		<class>com.restaurante.pedidos.dominio.entidad.HistorialEstadoPedido</class>
		<class>com.restaurante.pedidos.dominio.entidad.ReglaTransicionEstadoPedido</class>
		<class>com.restaurante.pedidos.dominio.entidad.Producto</class>
		<class>com.restaurante.pedidos.dominio.entidad.Rol</class>
		<class>com.restaurante.pedidos.dominio.entidad.Personal</class>

		<properties>
			<property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
			<property name="hibernate.hikari.jdbcUrl" value="jdbc:mysql://localhost:3307/first_bimester_project?useSSL=false&amp;serverTimezone=UTC&amp;characterEncoding=UTF-8"/>
			<property name="hibernate.hikari.username" value="root"/>
			<property name="hibernate.hikari.password" value="root"/>
			<property name="hibernate.hikari.driverClassName" value="com.mysql.cj.jdbc.Driver"/>
			<property name="hibernate.hikari.poolName" value="RestaurantOrdersPool"/>
			<property name="hibernate.hikari.minimumIdle" value="2"/>
			<property name="hibernate.hikari.maximumPoolSize" value="10"/>

			<property name="hibernate.hbm2ddl.auto" value="update"/>
			<property name="hibernate.show_sql" value="true"/>
			<property name="hibernate.format_sql" value="true"/>
			<property name="jakarta.persistence.validation.mode" value="none"/>
		</properties>
	</persistence-unit>
</persistence>
